# ── Database ──────────────────────────────────────────────
# Railway injects this automatically — set manually for local dev
DATABASE_URL=postgresql://user:password@localhost:5432/covenant

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Security (REQUIRED in production) ─────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_HMAC_KEY=change_me_64_hex_chars
PSEUDONYM_SECRET_KEY=change_me_64_hex_chars
JWT_SECRET_KEY=change_me_in_production

# ── Application ───────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
PORT=8000

# ── Vault / Key Backend ───────────────────────────────────
# Options: local | hashicorp | aws_kms
KEY_BACKEND=local
LOCAL_VAULT_KEY=change_me_64_hex_chars
# HASHICORP_VAULT_URL=
# HASHICORP_VAULT_TOKEN=
# AWS_KMS_KEY_ID=
# AWS_REGION=

# ── API Keys (optional — leave blank to disable routes) ───
IRONPASS_ADMIN_SECRET=change_me
IRONPASS_PROXY_API_KEY=
IRONPASS_DASHBOARD_API_KEY=

# ── LLM (SAR auto-generation) ─────────────────────────────
# Required for SAR drafting — falls back to template if missing
ANTHROPIC_API_KEY=

# ── Email Alerts ──────────────────────────────────────────
# Optional — alerting silently skipped if missing
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Vision Agent (Agent Ops) ──────────────────────────────
# Optional — vision routes return graceful error if missing
VISION_MODEL_API_KEY=
VISION_MODEL_BASE_URL=https://api.openai.com/v1
VISION_MODEL_NAME=gpt-4.1

# ── Agent Ops ─────────────────────────────────────────────
AGENT_OPS_WEBHOOK_SECRET=

# ── spaCy ─────────────────────────────────────────────────
SPACY_MODEL=en_core_web_lg

# ── Frontend (set in Railway frontend service) ────────────
# VITE_API_BASE_URL=https://your-backend.railway.app
# VITE_API_KEY=
