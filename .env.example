# ============================================================================
# Ironpass — Environment Variables
# ============================================================================
# Copy this file to .env and fill in all required values.
# Required variables have no defaults — the app will not start without them.
# ============================================================================

# --------------------------------------------------------------------------
# DATABASE (Required)
# --------------------------------------------------------------------------
DATABASE_URL=postgresql://ironpass:secret@localhost:5432/ironpass

# --------------------------------------------------------------------------
# REDIS (Required)
# --------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --------------------------------------------------------------------------
# SECURITY KEYS (Required — generate unique values, never commit real keys)
# --------------------------------------------------------------------------
# 64 hex characters — secret for HMAC-SHA256 signing of audit chain entries
AUDIT_HMAC_KEY=

# 64 hex characters — secret for deterministic pseudonym generation
PSEUDONYM_SECRET_KEY=

# --------------------------------------------------------------------------
# KEY MANAGEMENT (Required — choose one backend)
# --------------------------------------------------------------------------
# Options: "hashicorp", "aws_kms", "local" (development only, never production)
KEY_BACKEND=local

# If KEY_BACKEND=local (development only):
# 64 hex characters — the local encryption key used for dev vault encryption
LOCAL_VAULT_KEY=

# If KEY_BACKEND=hashicorp:
# HASHICORP_VAULT_URL=https://vault.internal:8200
# HASHICORP_VAULT_TOKEN=

# If KEY_BACKEND=aws_kms:
# AWS_KMS_KEY_ID=
# AWS_REGION=

# --------------------------------------------------------------------------
# APPLICATION
# --------------------------------------------------------------------------
# "production" or "development"
APP_ENV=development

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# API server bind address and port
API_HOST=0.0.0.0
API_PORT=8000

# --------------------------------------------------------------------------
# TOKEN VAULT
# --------------------------------------------------------------------------
# How many hours before vault tokens expire (default: 24)
VAULT_TOKEN_TTL_HOURS=24

# --------------------------------------------------------------------------
# spaCy NER MODEL
# --------------------------------------------------------------------------
# Must be downloaded before first start: python -m spacy download en_core_web_lg
SPACY_MODEL=en_core_web_lg
