# .env.production
# All variables from architecture.md PLUS these new ones:

# Deployment
APP_ENV=production
APP_VERSION=1.0.0
API_HOST=0.0.0.0
API_PORT=8000

# AWS
AWS_REGION=us-east-1
AWS_KMS_KEY_ID=arn:aws:kms:us-east-1:xxxx:key/xxxx
KEY_BACKEND=aws_kms

# Database (RDS)
DATABASE_URL=postgresql+asyncpg://ironpass:xxx@rds-endpoint:5432/ironpass

# Redis (ElastiCache)
REDIS_URL=redis://elasticache-endpoint:6379/0

# Security
AUDIT_HMAC_KEY=1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef
PSEUDONYM_SECRET_KEY=abcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890

# Rate limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20

# Upstream timeout
OPENAI_FORWARD_TIMEOUT_SECONDS=30

# Token TTL
VAULT_TOKEN_TTL_HOURS=24

# Gunicorn workers
GUNICORN_WORKERS=4
